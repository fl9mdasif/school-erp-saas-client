# Express API (the browser never sees this URL: Next rewrites /api/v1 to it)
API_BASE_URL=http://localhost:5000

# Browser-side base path for RTK Query (same origin through the rewrite)
NEXT_PUBLIC_BACKEND_API_URL=/api/v1

# Comma separated feature flags. Off by default: customDomain, sms
# on: portal, promotion, audit, pdf
NEXT_PUBLIC_FEATURES=portal,promotion,audit,pdf

# Product name and domain are placeholders until the brand is final
NEXT_PUBLIC_PLATFORM_NAME=xyz
NEXT_PUBLIC_PLATFORM_DOMAIN=xyz.com
